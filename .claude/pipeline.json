{
  "_comment": "Single source of truth for the pipeline state machine. Hooks read this file; do not hardcode tiers, phases or judges in hook scripts.",
  "state_ttl_hours": 8,
  "watchdog_minutes": 30,
  "protected_branches": ["main", "master"],
  "tiers": {
    "HOTFIX": {
      "team": "dev",
      "requires_issue": true,
      "phases": ["init", "coder", "tester", "judge_code", "commit", "pr", "notify", "done"],
      "judges": ["security", "architecture", "operations"]
    },
    "TASK": {
      "team": "dev",
      "requires_issue": true,
      "phases": [
        "init",
        "researcher",
        "architect",
        "judge_design",
        "planner",
        "coder",
        "tester",
        "judge_code",
        "compound",
        "commit",
        "pr",
        "notify",
        "done"
      ],
      "judges": ["security", "architecture", "operations"]
    },
    "PROJECT": {
      "team": "dev",
      "requires_issue": true,
      "phases": [
        "init",
        "researcher",
        "architect",
        "judge_design",
        "planner",
        "coder",
        "tester",
        "judge_code",
        "compound",
        "commit",
        "pr",
        "notify",
        "done"
      ],
      "judges": ["security", "architecture", "operations"]
    },
    "LEARN": {
      "team": "dev",
      "requires_issue": true,
      "learner_writes_code": true,
      "phases": [
        "init",
        "researcher",
        "architect",
        "judge_design",
        "planner",
        "learner",
        "tester",
        "judge_code",
        "compound",
        "commit",
        "pr",
        "notify",
        "done"
      ],
      "judges": ["security", "architecture", "operations"]
    },
    "MODULE": {
      "team": "content",
      "requires_issue": true,
      "phases": [
        "init",
        "researcher",
        "architect",
        "judge_design",
        "planner",
        "author",
        "student",
        "validate",
        "judge_content",
        "compound",
        "commit",
        "pr",
        "notify",
        "done"
      ],
      "judges": ["accuracy", "pedagogy", "assessment"]
    },
    "LESSON": {
      "team": "content",
      "requires_issue": true,
      "phases": [
        "init",
        "researcher",
        "author",
        "student",
        "validate",
        "judge_content",
        "commit",
        "pr",
        "notify",
        "done"
      ],
      "judges": ["accuracy", "pedagogy", "assessment"]
    },
    "RESEARCH": {
      "team": "any",
      "requires_issue": false,
      "phases": ["init", "researcher", "notify", "done"],
      "judges": []
    },
    "RELEASE": {
      "team": "dev",
      "requires_issue": false,
      "phases": ["init", "release", "notify", "done"],
      "judges": []
    }
  },
  "agent_gates": {
    "_comment": "agent file name -> earliest phase it may be spawned in. If that phase is not in the tier, the agent is not allowed in that tier at all.",
    "coder.md": "coder",
    "tester.md": "tester",
    "curriculum-architect.md": "architect",
    "lesson-author.md": "author",
    "practice-designer.md": "author",
    "student.md": "student"
  },
  "judge_agents": {
    "security": "judge-security.md",
    "architecture": "judge-architecture.md",
    "operations": "judge-operations.md",
    "accuracy": "judge-accuracy.md",
    "pedagogy": "judge-pedagogy.md",
    "assessment": "judge-assessment.md"
  },
  "learn_tier_editable_paths": [".claude/", "pipeline/", "docs/", "plans/", "learner/", "backlog/"]
}
