# Model only through the bank gateway; Claude Code appends /v1/messages itself.
ANTHROPIC_BASE_URL=https://llm.corp.local
# Bank root CA, one setting per tool: Claude Code (Node.js) and uv.
NODE_EXTRA_CA_CERTS=/etc/corp/ca-bundle.pem
SSL_CERT_FILE=/etc/corp/ca-bundle.pem
# uv installs only from the mirror: it replaces the public default index.
UV_DEFAULT_INDEX=https://pypi.corp.local/simple
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
