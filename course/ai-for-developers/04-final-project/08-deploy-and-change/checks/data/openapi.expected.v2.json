          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "Bookings_list",
        "description": "Bookings whose start lies in [from, to), sorted by start.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Range start, inclusive.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "explode": false
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Range end, exclusive; at most 31 days after from.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
