            },
            "description": "Availability windows on that date."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "A date override: replaces the weekly rules of its date; no intervals means a day off."
      },
      "DisplayText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "A text field shown to people: a schedule name, an event type title, an invitee name."
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
