            "type": "string",
            "description": "Problem type URI reference."
          },
          "title": {
            "type": "string",
            "description": "Short summary."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status, repeated in the body."
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode",
