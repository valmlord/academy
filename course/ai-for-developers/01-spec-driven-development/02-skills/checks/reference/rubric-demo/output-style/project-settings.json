{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_tests.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "outputStyle": "invoice"
}