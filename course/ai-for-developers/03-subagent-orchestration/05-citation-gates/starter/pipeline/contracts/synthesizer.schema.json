{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synthesizer output",
  "type": "object",
  "required": [
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "line",
          "quote",
          "claim",
          "severity",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Path from the project root"
          },
          "line": {
            "type": "integer"
          },
          "quote": {
            "type": "string",
            "description": "The exact text of that line"
          },
          "claim": {
            "type": "string",
            "description": "What is wrong, in one sentence"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of the section findings merged into this one"
          }
        }
      }
    }
  }
}
