{
  "name": "@academy/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace service: one Docker container per lesson, behind an internal HTTP API (ADR-0002, ADR-0010).",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@academy/lesson-schema": "workspace:*",
    "@fastify/websocket": "11.3.4",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "dockerode": "5.0.1",
    "fastify": "5.12.8",
    "tar-stream": "3.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
