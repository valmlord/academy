{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["ACADEMY_SKIP_ROOT_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["E2E_BASE_URL", "SEED_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL", "PORT", "BETTER_AUTH_SECRET"]
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "SEED_*"]
    },
    "@academy/web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/design/system/tokens.css"]
    }
  }
}
