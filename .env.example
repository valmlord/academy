# Copy to .env and adjust. Every variable the code reads must be listed here.

# Postgres (docker compose service "db")
POSTGRES_USER=academy
# Compose builds web's DATABASE_URL from it, so it must stay URL-safe (no @ : / ? #).
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy
DATABASE_URL=postgres://academy:academy@localhost:5432/academy
# Host port of the db service (docker compose). DATABASE_URL above must use the same port: the seed and
# pnpm dev connect through DATABASE_URL, not through DB_PORT.
# DB_PORT=5432

# Web app (added with issue: web bootstrap)
WEB_PORT=3080
# Image tag of the web service; only isolated test runs change it.
# WEB_IMAGE_TAG=local
# E2E_BASE_URL=http://127.0.0.1:3080
# Auth (#29). Required by docker compose (every command, also "up -d --wait db") and pnpm dev; at least
# 32 characters. Append a generated one without printing it:
#   printf 'BETTER_AUTH_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRETS is refused: use BETTER_AUTH_SECRET only.
# The seed creates the only user (pnpm seed, see README); the e2e tests sign in with the same values.
# Put them here, never on a command line.
# SEED_EMAIL=learner@example.com
# SEED_PASSWORD=
# Optional display name of that user, "Learner" when unset.
# SEED_NAME=
# WORKSPACE_SERVICE_URL=http://localhost:4100

# Workspace service (added with issue: workspace runtime)
# WORKSPACE_IMAGE=academy-workspace:dev
# WORKSPACE_CPU_LIMIT=2
# WORKSPACE_MEMORY_LIMIT=2g
# ANTHROPIC_API_KEY=   # passed into workspace containers only for agent-eval checks and the mentor
