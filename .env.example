# Copy to .env and adjust. Every variable the code reads must be listed here.

# Postgres (docker compose service "db")
POSTGRES_USER=academy
# Compose builds web's DATABASE_URL from it, so it must stay URL-safe (no @ : / ? #).
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy
# pnpm dev and pnpm seed reach db through the host port, which exists only while the shell that started db
# exported COMPOSE_FILE=docker-compose.yml:compose.db-port.yaml.
DATABASE_URL=postgres://academy:academy@localhost:5432/academy
# Host port of db, used only by compose.db-port.yaml. For pnpm dev, pnpm seed or a DB client, first run
# export COMPOSE_FILE=docker-compose.yml:compose.db-port.yaml in the shell.
# DATABASE_URL above must use the same port: the seed and pnpm dev connect through DATABASE_URL.
# DB_PORT=5432
# Compose's own variable. Export it in the shell for compose.db-port.yaml, never set it here; while it is
# exported every workspace reaches Postgres as the superuser (ADR-0002 item 6).
# COMPOSE_FILE=docker-compose.yml:compose.db-port.yaml

# Isolated test runs (#30): ACADEMY_SKIP_ROOT_ENV is exported in the shell, never put in this file (CI copies
# it to .env, so a line here would reach every later process). Unset, the root .env loads exactly as before;
# 1 skips it and next.config.ts, playwright.config.ts and scripts/seed.ts print
# "root .env not loaded: ACADEMY_SKIP_ROOT_ENV=1" on stderr; any other value stops startup naming the
# variable. Isolated runs pair it with COMPOSE_ENV_FILES=/dev/null, which keeps docker compose off this file.

# Web app (added with issue: web bootstrap)
WEB_PORT=3080
# Course content (#30): COURSE_ROOT is the absolute path of the directory that holds the course. Unset,
# pnpm dev reads the repository's course/; the image sets /app/course; a relative path is refused. Keep it a
# comment: a live line would reach pnpm dev and CI's copied .env. The workspace service requires it too;
# compose sets /course, its read-only mount of course/.
# COURSE_ROOT=/absolute/path/to/course
# Image tag of the web service; only isolated test runs change it.
# WEB_IMAGE_TAG=local
# E2E_BASE_URL=http://127.0.0.1:3080
# Auth (#29). Required by docker compose (every command, also "up -d --wait db") and pnpm dev; at least
# 32 characters. Append a generated one without printing it:
#   printf 'BETTER_AUTH_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRETS is refused: use BETTER_AUTH_SECRET only.
# The seed creates the only user (pnpm seed, see README); the e2e tests sign in with the same values.
# Put them here, never on a command line.
# SEED_EMAIL=learner@example.com
# SEED_PASSWORD=
# Optional display name of that user, "Learner" when unset.
# SEED_NAME=
# Base URL of the workspace service for web (#32); only on the internal network workspace-api.
# WORKSPACE_SERVICE_URL=http://workspace:4100

# Workspace service (#31, ADR-0002, ADR-0010). Every line stays a comment: CI copies this file to .env.
# Required by docker compose (every command, also "up -d --wait db"); at least 32 characters. Append a
# generated one without printing it:
#   printf 'WORKSPACE_SERVICE_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# WORKSPACE_SERVICE_SECRET=
# Isolated runs only: the label instance of every workspace object; compose defaults to local.
# WORKSPACE_INSTANCE=local
# Set by compose (0.0.0.0 and 4100 inside the container); the service itself defaults to 127.0.0.1.
# WORKSPACE_HOST=127.0.0.1
# WORKSPACE_PORT=4100
# Overrides every lesson's image; for tries before #33 and the probes. Empty means no override.
# WORKSPACE_IMAGE=node:22.23.4-alpine
# WORKSPACE_CPU_LIMIT=2
# WORKSPACE_MEMORY_LIMIT=2g
# WORKSPACE_PIDS_LIMIT=512
# ENVIRONMENT_IDLE_STOP_MINUTES=30
# ENVIRONMENT_IDLE_WARNING_MINUTES=5
# ENVIRONMENT_START_SLOW_SECONDS=10
# Set by compose to the mounted socket; read by the Docker client, not by the service's config.
# DOCKER_HOST=unix:///var/run/docker.sock
# Image tag of the workspace service; only isolated test runs change it.
# WORKSPACE_SERVICE_IMAGE_TAG=local
# ANTHROPIC_API_KEY=   # passed into workspace containers only for agent-eval checks and the mentor
