root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

# Generated by drizzle-kit (the journal has no final newline); an editor fix would be a migration edit.
[packages/db/drizzle/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
